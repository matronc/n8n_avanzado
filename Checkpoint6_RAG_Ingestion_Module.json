    {
      "parameters": {
        "jsCode": "const UMBRAL = 0.88;\nconst archivos = $('Primer fragmento').all();\nconst similares = {};\nfor (const r of $input.all()) {\n  const idx = r.pairedItem && r.pairedItem.item !== undefined ? r.pairedItem.item : (Array.isArray(r.pairedItem) ? r.pairedItem[0].item : undefined);\n  const doc = r.json.document || {};\n  const score = Number(r.json.score);\n  const id = doc.metadata && doc.metadata.drive_file_id;\n  if (idx === undefined || !id || !(score >= UMBRAL)) continue;\n  similares[idx] = { id, score };\n}\nreturn archivos.map((a, i) => ({\n  json: {\n    ...a.json,\n    reemplazar_id: similares[i] ? similares[i].id : '__ninguno__',\n    reemplazo_score: similares[i] ? similares[i].score : 0,\n    requiere_revision_reemplazo: Boolean(similares[i]),\n  },\n  binary: a.binary,\n}));"
      },
