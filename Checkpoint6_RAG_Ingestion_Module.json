    {
      "parameters": {
        "jsCode": "const vistos = new Set();\nconst out = [];\nfor (const a of $('Calcular hash').all()) {\n  // Las cargas existentes también pasan a similitud y HITL para permitir reemplazos o renombrados aprobados.\n  const cargaKey = `${a.json.drive_file_id}:${a.json.content_hash}:${String(a.json.nombre || '')}`;\n  if (vistos.has(cargaKey)) continue;\n  vistos.add(cargaKey);\n  out.push({ json: a.json, binary: a.binary });\n}\nreturn out;"
      },
