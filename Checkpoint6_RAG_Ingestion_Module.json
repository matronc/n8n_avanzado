    {
      "parameters": {
        "jsCode": "function sha256(d){\nconst K=[],H=[];\nfor(let n=2;K.length<64;n++){let p=true;for(let i=2;i*i<=n;i++)if(n%i===0){p=false;break;}if(!p)continue;K.push(Math.floor((Math.cbrt(n)%1)*4294967296)>>>0);if(H.length<8)H.push(Math.floor((Math.sqrt(n)%1)*4294967296)>>>0);}\nconst len=d.length,total=((len+9+63)>>6)<<6;\nconst m=new Uint8Array(total);m.set(d);m[len]=0x80;\nconst dv=new DataView(m.buffer);\ndv.setUint32(total-8,Math.floor(len/536870912));dv.setUint32(total-4,(len<<3)>>>0);\nconst w=new Uint32Array(64);\nconst r=(x,n)=>(x>>>n)|(x<<(32-n));\nfor(let o=0;o<total;o+=64){\nfor(let i=0;i<16;i++)w[i]=dv.getUint32(o+i*4);\nfor(let i=16;i<64;i++){const a=r(w[i-15],7)^r(w[i-15],18)^(w[i-15]>>>3),b=r(w[i-2],17)^r(w[i-2],19)^(w[i-2]>>>10);w[i]=(w[i-16]+a+w[i-7]+b)>>>0;}\nlet [A,B,C,D,E,F,G,I]=H;\nfor(let i=0;i<64;i++){const t1=(I+(r(E,6)^r(E,11)^r(E,25))+((E&F)^(~E&G))+K[i]+w[i])>>>0;const t2=((r(A,2)^r(A,13)^r(A,22))+((A&B)^(A&C)^(B&C)))>>>0;I=G;G=F;F=E;E=(D+t1)>>>0;D=C;C=B;B=A;A=(t1+t2)>>>0;}\nH[0]=(H[0]+A)>>>0;H[1]=(H[1]+B)>>>0;H[2]=(H[2]+C)>>>0;H[3]=(H[3]+D)>>>0;H[4]=(H[4]+E)>>>0;H[5]=(H[5]+F)>>>0;H[6]=(H[6]+G)>>>0;H[7]=(H[7]+I)>>>0;\n}\nreturn H.map(x=>x.toString(16).padStart(8,'0')).join('');\n}\nconst base = $('Normalizar archivo').all();\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const content_hash = sha256(new Uint8Array(buffer));\n  out.push({\n    json: { drive_file_id: base[i].json.id, nombre: base[i].json.name, content_hash },\n    binary: items[i].binary,\n  });\n}\nreturn out;"
      },
