    {
      "parameters": {
        "jsCode": "const archivos = $('Filtrar duplicados').all();\nconst textos = $input.all();\nif (archivos.length !== textos.length) {\n  throw new Error(`La cantidad de textos extraídos (${textos.length}) no coincide con los archivos (${archivos.length}).`);\n}\nreturn archivos.map((a, i) => {\n  const t = String((textos[i] && textos[i].json && textos[i].json.text) || '').replace(/\\s+/g, ' ').trim();\n  if (!t) throw new Error(`No se pudo extraer texto del PDF \"${a.json.nombre}\"; se conserva la versión ya indexada.`);\n  return { json: { ...a.json, query: t.slice(0, 1000) }, binary: a.binary };\n});"
      },
