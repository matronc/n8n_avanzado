    {
      "parameters": {
        "jsCode": "// Capturamos el mensaje original desde tu nodo 'Input de Slack'\nconst original = $('Input  de Slack').first().json.mensaje;\n\n// Extraemos el texto crudo devuelto por la IA\nconst raw = $json.text ?? $json.output ?? $json.response ?? '';\n\nlet d;\ntry {\n  // Limpiamos bloques markdown (```json ... ```) si la IA los incluyó y parseamos\n  d = JSON.parse(String(raw).replace(/^```json\\s*/i, '').replace(/```$/, '').trim());\n} catch (e) {\n  // Fallback seguro si falla el parseo\n  d = { intent: 'UNKNOWN', confidence: 0, risk: 'HIGH' };\n}\n\n// Taxonomía permitida para GustoBot\nconst allowed = ['REGISTRAR_PEDIDO', 'CONSULTA_MENU', 'RECLAMO_SOPORTE', 'UNKNOWN'];\n\n// Validaciones y normalización\nconst intent = allowed.includes(d.intent) ? d.intent : 'UNKNOWN';\nconst confidence = Math.max(0, Math.min(1, Number(d.confidence ?? 0)));\nconst risk = ['LOW', 'MEDIUM', 'HIGH'].includes(d.risk) ? d.risk : 'HIGH';\n\n// Retornamos el objeto normalizado para el Switch y los Workers\nreturn [{\n  json: {\n    original_input: original,\n    intent: intent,\n    confidence: confidence,\n    risk: risk\n  }\n}];"
      },
