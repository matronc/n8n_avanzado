      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n  \n  // Extraer valores con fallback por seguridad\n  const ts = data.timestamp || new Date().toISOString();\n  const worker = data.worker || 'UNKNOWN';\n  const status = data.status || 'success';\n  const hitl = data.requires_human ?? false;\n  \n  // Construir string de trazabilidad estandarizado\n  const logString = `[${ts}] | WORKER: ${worker} | STATUS: ${status} | HITL: ${hitl}`;\n\n  return {\n    json: {\n      ...data,\n      log: logString\n    }\n  };\n});"
      },
