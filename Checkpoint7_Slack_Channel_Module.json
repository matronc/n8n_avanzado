      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const match = Object.entries(item.binary ?? {}).find(([, file]) =>\n    (file.mimeType ?? '').toLowerCase().startsWith('audio/') ||\n    /\\.(ogg|oga|opus|mp3|wav|m4a|webm|aac|flac)$/i.test(file.fileName ?? '')\n  );\n  if (!match) throw new Error('Slack audio attachment was not present in binary data.');\n  return { json: item.json, binary: { data: match[1] } };\n});"
      },
